<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/preview_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="あと3枚"
            android:textColor="@color/widget_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_undo"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_undo"
            android:textColor="@color/widget_sub"
            android:textSize="12sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_undo_description"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥5"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/preview_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:max="5"
        android:progress="2"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="visible" />

    <!-- Today's top card. -->
    <LinearLayout
        android:id="@+id/preview_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_mint"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/preview_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="水を1杯のむ"
            android:textColor="@color/widget_card_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/preview_miss"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_miss"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_miss_button"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_done"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_done"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_done_button"
            android:textColor="@color/widget_background"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown instead of the card when today is done, a rest day, or out of date. -->
    <LinearLayout
        android:id="@+id/preview_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/preview_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_stale_big"
            android:textColor="@color/widget_ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_stale_small"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
